    {
      "id": "NWv4nfVWO_yi9SQRjRQao",
      "type": "text",
      "x": 6343.815403613138,
      "y": 431.2092261833421,
      "width": 605.0446116083021,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 289044654,
      "version": 816,
      "versionNonce": 924716466,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788779447789,
      "link": null,
      "locked": false,
      "text": "06_자연어처리 - ch3_연관분석\n\nimport csv \nwith open(...) as f: : csv 파일을 열어서 파일 객체를 만든다\ncsv.reader(f) : f라는 csv 파일을 읽을 수 있도록 reader를 실행\n\nrules = apriori(...)\n└▶ transaction 데이터를 Apriori 알고리즘으로 분석하되,\n         일정 기준 이상의 연산규칙만 찾아라\n\nmin_support=0.15 : 전체 거래 중 최소 15% 이상에서 나타나는 항목 조합을 고려함\nmin_confidence=0.1 : 최소 신뢰도를 10%로 설정\nmin_lift=1.001 : 항상도가 최소 1.001 이상인 규칙을 대상으로 한다.\n\nlhs = item[0] : 연관규칙의 조건 부분을 가져온다.\n\nround(confidence, 2) : 신뢰도를 소수점 둘째 자리까지 반올림\nround(숫자, 반올림할_자리수)",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "06_자연어처리 - ch3_연관분석\n\nimport csv \nwith open(...) as f: : csv 파일을 열어서 파일 객체를 만든다\ncsv.reader(f) : f라는 csv 파일을 읽을 수 있도록 reader를 실행\n\nrules = apriori(...)\n└▶ transaction 데이터를 Apriori 알고리즘으로 분석하되,\n         일정 기준 이상의 연산규칙만 찾아라\n\nmin_support=0.15 : 전체 거래 중 최소 15% 이상에서 나타나는 항목 조합을 고려함\nmin_confidence=0.1 : 최소 신뢰도를 10%로 설정\nmin_lift=1.001 : 항상도가 최소 1.001 이상인 규칙을 대상으로 한다.\n\nlhs = item[0] : 연관규칙의 조건 부분을 가져온다.\n\nround(confidence, 2) : 신뢰도를 소수점 둘째 자리까지 반올림\nround(숫자, 반올림할_자리수)",
      "autoResize": false,
